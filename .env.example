# ═══════════════════════════════════════════════════
# VVonderXI — Environment Variables
# ═══════════════════════════════════════════════════
#
# HOW TO USE:
# In Vercel: go to Project → Settings → Environment Variables
# and add each key/value pair there.
# Never paste actual keys into your code files.
#
# ═══════════════════════════════════════════════════

# ── ANTHROPIC (Claude AI Live analysis) ──────────────
# Get your key: https://console.anthropic.com
# Free $5 credit on signup. ~$0.003-0.005 per analysis.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── SUPABASE (Player cache database + Auth) ──────────
# Create free project: https://supabase.com
# Find these at: Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── CRON JOB SECRET ──────────────────────────────────
# Any random string to protect the daily refresh endpoint
# Generate one at: https://randomkeygen.com
CRON_SECRET=your-random-secret-here

# ── GOOGLE OAUTH (Coming soon — leave blank for now) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
