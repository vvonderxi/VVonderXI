{
  "cleanUrls": true,
  "fluid": true,
  "headers": [
    {
      "source": "/og-image.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/db.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "crons": [
    { "path": "/api/refresh-players", "schedule": "0 3 * * *" }
  ]
}
