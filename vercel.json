{
  "rewrites": [
    { "source": "/api/search-player", "destination": "/api/search-player.js" },
    { "source": "/api/analyse", "destination": "/api/analyse.js" },
    { "source": "/api/get-seasons", "destination": "/api/get-seasons.js" },
    { "source": "/api/refresh-players", "destination": "/api/refresh-players.js" },
    { "source": "/api/debug-player", "destination": "/api/debug-player.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/refresh-players",
      "schedule": "0 3 * * *"
    }
  ]
}
